# Production environment — Vite bakes this in at build time
# VITE_API_URL is intentionally EMPTY so all /api/* calls go to the same origin.
# Nginx on the EC2 host proxies https://65-0-244-196.sslip.io/api/* → backend:8080
# This means the built JS never needs to know the backend host explicitly.
VITE_API_URL=
